# Copy to .env.local and fill in real values. Never commit .env.local.

# Calendly embed on the contact / booking page (public)
NEXT_PUBLIC_CALENDLY_URL="https://calendly.com/your-org/30min"

# Clerk (https://dashboard.clerk.com) — public + server
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxx
CLERK_SECRET_KEY=sk_test_xxxx

# Postgres (e.g. Neon) — use pooled URL in production if your host recommends it
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Comma-separated Clerk user IDs allowed to use /admin (server-only)
INTERNAL_ADMIN_CLERK_IDS=user_xxxx
